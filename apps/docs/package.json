{
  "name": "@cumulo/docs",
  "version": "0.1.0",
  "private": true,
  "source": "routes.ts",
  "type": "module",
  "scripts": {
    "dev": "parcel serve --config .parcelrc",
    "build": "rm -rf dist && parcel build --config .parcelrc",
    "start": "npx http-server ./dist",
    "type-check": "oxlint"
  },
  "dependencies": {
    "@cumulo/core": "workspace:*",
    "@cumulo/css": "workspace:*",
    "@parcel/rsc": "^3.0.0-alpha.3",
    "@renr/parcel-rsc-router": "github:renrizzolo/parcel-rsc-react#feat/git-installable-v3-packages&path:packages/parcel-rsc-router",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-parcel": "^19.2.8"
  },
  "devDependencies": {
    "@cumulo/parcel-plugin": "workspace:*",
    "@renr/parcel-plugin-rsc-router": "github:renrizzolo/parcel-rsc-react#feat/git-installable-v3-packages&path:packages/parcel-plugin-rsc-router",
    "@renr/parcel-reporter-docgen": "github:renrizzolo/parcel-rsc-react#feat/git-installable-v3-packages&path:packages/parcel-reporter-docgen",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "parcel": "^3.0.0-alpha.3",
    "shiki": "^4.4.3",
    "typescript": "^5.8.2"
  },
  "@renr/parcel-plugin-rsc-router": {
    "source": "src/pages/**/*.{tsx,mdx}",
    "output": "routes.ts"
  },
  "@renr/parcel-reporter-docgen": {
    "source": "../../packages/core/src/components/*.{ts,tsx}",
    "output": "docgen/components"
  },
  "targets": {
    "default": {
      "context": "react-server",
      "distDir": "dist",
      "includeNodeModules": {
        "oxfmt": false,
        "shiki": false
      }
    }
  }
}
