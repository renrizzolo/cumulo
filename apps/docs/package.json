{
  "name": "@cumulo/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "parcel",
    "build": "parcel build --no-cache",
    "start": "npx http-server ./dist",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@cumulo/core": "workspace:*",
    "@cumulo/css": "workspace:*",
    "@parcel/config-default": "^2.16.4",
    "@parcel/rsc": "^2.16.4",
    "@renr/parcel-rsc-router": "^1.0.0-alpha.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-parcel": "^19.2.8"
  },
  "devDependencies": {
    "@cumulo/parcel-transformer": "workspace:*",
    "@parcel/packager-react-static": "2.16.4",
    "@parcel/transformer-react-static": "2.16.4",
    "@renr/parcel-reporter-docgen": "^0.1.0-alpha.5",
    "@renr/parcel-reporter-rsc-router": "^1.0.0-alpha.16",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "parcel": "^2.16.4",
    "shiki": "^4.4.3",
    "typescript": "^5.8.2"
  },
  "targets": {
    "react-static": {
      "source": "src/pages/**/*",
      "context": "react-server",
      "includeNodeModules": {
        "oxfmt": false,
        "shiki": false
      }
    }
  }
}
