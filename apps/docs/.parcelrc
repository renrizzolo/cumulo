{
  "extends": "@parcel/config-default",
  "transformers": {
    "raw-text:*": [
      "@parcel/transformer-inline-string"
    ],
    "*.{ts,tsx,js,jsx,mjs}": [
      "@cumulo/parcel-transformer",
      "..."
    ]
  },
  "reporters": [
    "...",
    "@renr/parcel-reporter-rsc-router",
    "@renr/parcel-reporter-docgen"
  ]
}
