{
  "name": "@cumulo/core",
  "version": "0.1.0",
  "description": "Core design tokens, theme contracts, and base utilities for Cumulo UI",
  "style": "./src/theme.css",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.cts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json",
    "./theme.css": "./dist/theme.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "theme": "node scripts/generate-theme.ts",
    "dev": "node scripts/generate-theme.ts && tsdown --watch",
    "build": "node scripts/generate-theme.ts && tsdown",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@cumulo/css": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@tsdown/css": "^0.22.14",
    "@types/react": "^19.0.0",
    "jsdom": "^29.1.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "react": "^19.2.8"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
