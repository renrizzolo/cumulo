{
  "name": "@cumulo/unplugin",
  "version": "0.1.0",
  "description": "Universal build plugin for Cumulo CSS with support for Vite, Webpack, Rollup, esbuild, and Parcel",
  "type": "module",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": "./dist/index.mjs",
    "./esbuild": "./dist/esbuild.mjs",
    "./parcel": "./dist/parcel.mjs",
    "./rollup": "./dist/rollup.mjs",
    "./vite": "./dist/vite.mjs",
    "./webpack": "./dist/webpack.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@cumulo/css": "workspace:*",
    "jiti": "^2.7.0",
    "unplugin": "^2.2.0"
  },
  "devDependencies": {
    "@parcel/plugin": "^2.16.4",
    "@types/node": "^22.13.9",
    "tsdown": "^0.22.14",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "@parcel/plugin": "^2.16.4"
  },
  "peerDependenciesMeta": {
    "@parcel/plugin": {
      "optional": true
    }
  }
}
