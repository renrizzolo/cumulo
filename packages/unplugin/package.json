{
  "name": "@cumulo/unplugin",
  "version": "0.2.0-alpha.0",
  "description": "Universal build plugin for Cumulo CSS with support for Vite, Webpack, Rollup, esbuild, and Parcel",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./esbuild": {
      "import": "./dist/esbuild.mjs",
      "require": "./dist/esbuild.cjs"
    },
    "./next": {
      "import": "./dist/next.mjs",
      "require": "./dist/next.cjs"
    },
    "./parcel": {
      "import": "./dist/parcel.mjs",
      "require": "./dist/parcel.cjs"
    },
    "./postcss": {
      "import": "./dist/postcss.mjs",
      "require": "./dist/postcss.cjs"
    },
    "./rollup": {
      "import": "./dist/rollup.mjs",
      "require": "./dist/rollup.cjs"
    },
    "./vite": {
      "import": "./dist/vite.mjs",
      "require": "./dist/vite.cjs"
    },
    "./webpack": {
      "import": "./dist/webpack.mjs",
      "require": "./dist/webpack.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@cumulo/css": "workspace:*",
    "jiti": "^2.7.0",
    "unplugin": "^2.2.0"
  },
  "devDependencies": {
    "@parcel/plugin": "^2.16.4",
    "@types/node": "^22.13.9",
    "tsdown": "^0.22.14",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "@parcel/plugin": "^2.16.4"
  },
  "peerDependenciesMeta": {
    "@parcel/plugin": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
