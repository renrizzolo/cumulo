{
  "name": "@cumulo/css",
  "version": "0.2.0-alpha.1",
  "description": "Lightweight, zero-dependency type-safe CSS framework inspired by StyleX and Vanilla Extract",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renrizzolo/cumulo.git",
    "directory": "packages/css"
  },
  "source": "./src/index.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.mts",
      "import": "./dist/runtime.mjs",
      "default": "./dist/runtime.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "type-check": "oxlint",
    "bench": "vitest bench"
  },
  "devDependencies": {
    "csstype": "^3.2.3",
    "tsdown": "^0.22.14",
    "typescript": "^5.8.2"
  },
  "inlinedDependencies": {
    "csstype": "3.2.3"
  }
}
