{
  "name": "@cumulo/css",
  "version": "0.1.0",
  "description": "Lightweight, zero-dependency type-safe CSS framework inspired by StyleX and Vanilla Extract",
  "source": "./src/index.ts",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.cts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "tsdown": "^0.22.14",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
