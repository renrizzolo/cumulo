{
  "name": "@cumulo/parcel-transformer",
  "version": "0.1.0",
  "description": "Parcel transformer for Cumulo CSS static extraction",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@cumulo/unplugin": "workspace:*",
    "@parcel/plugin": "^2.16.4"
  },
  "devDependencies": {
    "tsdown": "^0.22.14",
    "typescript": "^5.8.2"
  },
  "engines": {
    "parcel": ">=2.0.0"
  }
}
