{
  "name": "cumulo-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "type-check": "oxlint",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "theme": "pnpm --filter @cumulo/core theme",
    "check": "pnpm lint:fix && pnpm format",
    "check:ci": "pnpm lint && pnpm format:check",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:browser": "pnpm --filter @cumulo/fixtures exec vitest run --project browser",
    "bench": "vitest bench",
    "bench:css": "pnpm --filter @cumulo/css bench",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@parcel/rsc": "^3.0.0-alpha.3",
    "@types/node": "^24",
    "buffer": "^6.0.3",
    "diff": "^9.0.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "react": "^19.2.8",
    "react-server-dom-parcel": "^19.2.8",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "typescript": "^5.8.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.22.0"
}
