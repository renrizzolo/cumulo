{
  "name": "cumulo-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "type-check": "pnpm -r type-check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "pnpm type-check && pnpm lint:fix && pnpm format",
    "check:ci": "pnpm type-check && pnpm lint && pnpm format:check",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:browser": "pnpm --filter @cumulo/fixtures exec vitest run --project browser",
    "bench": "vitest bench",
    "bench:css": "vitest bench packages/css",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@parcel/packager-react-static": "2.16.4",
    "@parcel/runtime-rsc": "2.16.4",
    "@parcel/transformer-react-static": "2.16.4",
    "@types/node": "^24",
    "buffer": "^6.0.3",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "react-server-dom-parcel": "^19.2.8",
    "typescript": "^5.8.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@11.22.0",
  "@renr/parcel-reporter-docgen": {
    "source": "packages/core/src/components/*.{ts,tsx}",
    "output": "apps/docs/docgen/components"
  },
  "@renr/parcel-reporter-rsc-router": {
    "output": "apps/docs/routes.ts"
  },
  "targets": {
    "react-static": {
      "source": "apps/docs/src/pages/**/*.{tsx,mdx}",
      "context": "react-server"
    }
  }
}
